{
  "name": "dsh-office-preview",
  "version": "1.0.0",
  "description": "Word (.docx) and Excel (.xlsx) previews for the DeepSeek Harness sidebar document pane — OOXML parsed locally in the browser, no Office installation and no network.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.1-rc.2",
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2 || ^0.1.2-alpha.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "^0.1.1-rc.2 || ^0.1.2-alpha.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2 || ^0.1.2-alpha.1 || ^0.1.5-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.1-rc.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "office",
    "word",
    "excel",
    "docx",
    "xlsx",
    "ooxml",
    "preview",
    "document-preview",
    "sidebar"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "JohnGD",
  "homepage": "https://github.com/JohnGD/dsh-office-preview#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnGD/dsh-office-preview.git"
  }
}
